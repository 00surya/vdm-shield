# Replace placeholders in the production hosting secret store. Never commit real secrets.
VDM_CLOUD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vdm
VDM_PUBLIC_URL=https://YOUR-DOMAIN
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM=accounts@YOUR-DOMAIN
# Durable directory containing verified installers and releases.json.
VDM_RELEASE_DIR=/srv/vdm/releases
# Use 0 to require service-owner provisioning for all new organizations.
VDM_TRIAL_DAYS=14
